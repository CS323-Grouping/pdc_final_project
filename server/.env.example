# Copy to .env and adjust. .env is gitignored.

# HTTP listen address
ADDR=:8080

# Postgres connection string — matches docker-compose.yml defaults
DATABASE_URL=postgres://cssocial:dev@localhost:5433/cssocial?sslmode=disable

# JWT signing secret — MUST be at least 32 bytes. Generate with:
#   openssl rand -base64 48
# Rotate yearly in production; rotation invalidates all existing tokens.
JWT_SECRET=dev-only-secret-replace-me-with-32-plus-bytes-of-entropy

# Logging — debug | info | warn | error
LOG_LEVEL=info

# Optional comma-separated WebSocket Origin host patterns. Empty allows native
# clients with no Origin and same-host browser clients only.
# Example: WS_ALLOWED_ORIGINS=game.example.com,localhost:3000
WS_ALLOWED_ORIGINS=

# Optional comma-separated proxy CIDRs whose X-Forwarded-For headers are trusted.
# Leave empty for direct local dev so clients cannot spoof rate-limit buckets.
# Example for local Caddy: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
