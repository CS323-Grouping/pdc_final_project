# Copy to .env and adjust. .env is gitignored.

# HTTP listen address
ADDR=:8080

# Postgres connection string — matches docker-compose.yml defaults
DATABASE_URL=postgres://cssocial:dev@localhost:5433/cssocial?sslmode=disable

# JWT signing secret — MUST be at least 32 bytes. Generate with:
#   openssl rand -base64 48
# Rotate yearly in production; rotation invalidates all existing tokens.
JWT_SECRET=dev-only-secret-replace-me-with-32-plus-bytes-of-entropy

# Logging — debug | info | warn | error
LOG_LEVEL=info
